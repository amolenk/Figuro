{
  "name": "@figuro/slidev",
  "version": "0.1.0",
  "description": "Render local Excalidraw drawings in Slidev",
  "license": "MIT",
  "type": "module",
  "keywords": ["slidev-addon", "slidev", "excalidraw", "figuro"],
  "files": ["components", "setup", "src", "README.md"],
  "engines": { "slidev": ">=53.0.0 <54.0.0" },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "playwright test",
    "test:docker": "docker build -f Dockerfile -t figuro-slidev-tests ../.. && docker run --rm --ipc=host figuro-slidev-tests"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@vue/compiler-dom": "^3.5.0",
    "@vue/compiler-sfc": "^3.5.0"
  },
  "peerDependencies": {
    "@slidev/cli": ">=53.0.0 <54.0.0",
    "vue": "^3.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0",
    "@slidev/types": "53.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "markdown-it": "14.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.1.0"
  }
}
