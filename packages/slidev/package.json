  "description": "Render local Excalidraw drawings in Slidev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amolenk/Figuro.git",
    "directory": "packages/slidev"
  },
  "homepage": "https://github.com/amolenk/Figuro/tree/main/packages/slidev#readme",
  "bugs": { "url": "https://github.com/amolenk/Figuro/issues" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "keywords": ["slidev-addon", "slidev", "excalidraw", "figuro"],
  "files": ["components", "setup", "src", "README.md", "LICENSE"],
