    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0",
    "@slidev/types": "53.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "markdown-it": "14.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.1.0"
  }
