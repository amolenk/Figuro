{
  "name": "figuro",
  "private": true,
  "version": "0.1.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "build": "pnpm --filter @figuro/editor-host build",
    "dev": "pnpm --filter @figuro/editor-host dev",
    "test:ui:start": "python3 scripts/ui-tests.py start",
    "test:ui:status": "python3 scripts/ui-tests.py status",
    "test:ui:results": "python3 scripts/ui-tests.py results",
    "test:ui:wait": "python3 scripts/ui-tests.py wait",
    "test:ui:runner": "python3 scripts/ui-tests.py runner",
    "test:ui:runner:check": "python3 -m unittest discover -s scripts/tests -v"
  }
}
